{
  "description": "Repository Git policy checks shared with Claude Code.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.claude/hooks/prevent-direct-push.py\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.claude/hooks/require-preflight.py\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.claude/hooks/validate-branch-name.py\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.claude/hooks/update-changelog-before-pr.py\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.claude/hooks/enforce-pr-base-branch.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
